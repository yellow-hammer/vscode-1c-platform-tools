////////////////////////////////////////////////////////////
// Описание пакета для сборки и установки
// Полную документацию см. на hub.oscript.io/packaging
//


Описание.Имя("autumn")
        .Версия("5.0.3")
        .Автор("Nikita Fedkin")
        .АдресАвтора("nixel2007@gmail.com")
        .АдресРепозитория("https://github.com/autumn-library/autumn")
        .Описание("Dependency injection framework для OneScript")
        .ВерсияСреды("2.2.1")
        .ВключитьФайл("src")
        .ВключитьФайл("tests")
        .ВключитьФайл("LICENSE.md")
        .ВключитьФайл("README.md")
        .ЗависитОт("annotations", "1.6.0")
        .ЗависитОт("asserts", "1.6.2")
        .ЗависитОт("configor", "0.12.1")
        .ЗависитОт("decorator", "3.1.2")
        .ЗависитОт("logos", "1.7.1")
        .ЗависитОт("fluent", "0.6.1")
        .ЗависитОт("reflector", "0.7.1")
        .ЗависитОт("semaphore", "1.1.1")
        .ЗависитОт("collectionos", "0.9.0")
        .ЗависитОт("autumn-collections", "0.1.1")
        .ЗависитОт("lambdas", "0.3.5")

        .РазработкаЗависитОт("asserts")
        .РазработкаЗависитОт("benchmark", "0.9.1")
        .РазработкаЗависитОт("oneunit", "0.5.2")

        .ОпределяетКласс("Поделка", "src/Классы/Поделка.os")
        .ОпределяетКласс("Завязь", "src/Классы/Завязь.os")
        .ОпределяетКласс("ОпределениеЖелудя", "src/Классы/ОпределениеЖелудя.os")
        .ОпределяетКласс("ПрилепляемаяЧастица", "src/Классы/ПрилепляемаяЧастица.os")
        .ОпределяетКласс("Табакерка", "src/Классы/Табакерка.os")
        .ОпределяетКласс("СоветДругогоМастера", "src/Классы/СоветДругогоМастера.os")
        .ОпределяетМодуль("СостоянияПриложения", "src/Модули/СостоянияПриложения.os")
        .ОпределяетМодуль("ТипыПрилепляемыхЧастиц", "src/Модули/ТипыПрилепляемыхЧастиц.os")
        .ОпределяетМодуль("ХарактерыЖелудей", "src/Модули/ХарактерыЖелудей.os")
        ;
