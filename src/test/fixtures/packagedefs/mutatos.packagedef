////////////////////////////////////////////////////////////
// Описание пакета для сборки и установки
// Полную документацию см. на hub.oscript.io/packaging

Описание.Имя("mutatos")
        .Версия("1.0.0")
        .ВерсияСреды("2.0.0")
        .Автор("Nikita Fedkin")
        .АдресАвтора("nixel2007@gmail.com")
        .АдресРепозитория("https://github.com/nixel2007/mutatos")
        .Описание("Мутационное тестирование для OneScript")

        .ВключитьФайл("src")
        .ВключитьФайл("oscript_modules")
        .ВключитьФайл("README.md")
        .ВключитьФайл("LICENSE.md")
        .ИсполняемыйФайл("src/cli/main.os", "mutatos")

        .ЗависитОт("osparser", "0.1.0")
        .ЗависитОт("progbar", "1.4")
        .ЗависитОт("oneunit", "0.5.0")
        .ЗависитОт("semver", "1.1.1")
        .ЗависитОт("autumn", "4.3.13")
        .ЗависитОт("autumn-cli", "1.3.0")
        .ЗависитОт("autumn-logos", "1.3.3")
        .ЗависитОт("1commands", "1.5.0")
        .ЗависитОт("fs", "1.2.0")
        .ЗависитОт("json", "1.1.2")
        .ЗависитОт("tempfiles", "1.1.1")

        .РазработкаЗависитОт("asserts", "1.6.2")
        .РазработкаЗависитОт("moskito", "1.0.0")
