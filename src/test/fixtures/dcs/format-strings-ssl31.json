			"expression": "ВЫБОР\n    КОГДА &ПериодичностьЗамеров=1 ТОГДА ФОРМАТ(ПериодЗамера, \"ДФ='дд.ММ.гггг''г. '' ЧЧ:мм'\")+ \"-\" + ФОРМАТ(ДОБАВИТЬКДАТЕ(ПериодЗамера,\"Минута\",59), \"ДФ='ЧЧ:мм'\")\n    КОГДА &ПериодичностьЗамеров=2 ТОГДА ФОРМАТ(ПериодЗамера, \"ДФ='дд.ММ.гггг'\") + \"г.\"\n    КОГДА &ПериодичностьЗамеров=3 ТОГДА\n        ВЫБОР\n            КОГДА НАЧАЛОПЕРИОДА(ПериодЗамера, \"НЕДЕЛЯ\") < &НачалоПериода ТОГДА ФОРМАТ(&НачалоПериода, \"ДФ='дд.ММ.гггг''г.'''\") + \" - \" + ФОРМАТ(КОНЕЦПЕРИОДА(ПериодЗамера,\"НЕДЕЛЯ\"), \"ДФ='дд.ММ.гггг''г. '''\")\n            КОГДА КОНЕЦПЕРИОДА(ПериодЗамера, \"НЕДЕЛЯ\") > &КонецПериода ТОГДА ФОРМАТ(НАЧАЛОПЕРИОДА(ПериодЗамера, \"НЕДЕЛЯ\"), \"ДФ='дд.ММ.гггг''г.'''\")+ \" - \" + ФОРМАТ(&КонецПериода, \"ДФ='дд.ММ.гггг''г. '''\")\n            ИНАЧЕ ФОРМАТ(НАЧАЛОПЕРИОДА(ПериодЗамера, \"НЕДЕЛЯ\"), \"ДФ='дд.ММ.гггг''г.'''\")+ \" - \" + ФОРМАТ(КОНЕЦПЕРИОДА(ПериодЗамера,\"НЕДЕЛЯ\"), \"ДФ='дд.ММ.гггг''г. '''\")\n        КОНЕЦ\n    КОГДА &ПериодичностьЗамеров=4 ТОГДА ФОРМАТ(&НачалоПериода, \"ДФ='дд.ММ.гггг'\") + \" - \" + ФОРМАТ(&КонецПериода, \"ДФ='дд.ММ.гггг'\")\nКОНЕЦ",
