Описание.Имя("{{name}}")
    .Версия("1.0.0")
    .ВерсияСреды("2.2.1")
    .ВключитьФайл("src")
    .ВключитьФайл("tests")
    .ИсполняемыйФайл("src/main.os", "{{name}}")
    .РазработкаЗависитОт("oneunit")
    .РазработкаЗависитОт("asserts")
    .РазработкаЗависитОт("mutatos")

;
